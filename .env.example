# ============================================================================
# Gemini-Mini-IDE Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control!

# LLM Configuration
# -----------------
# Your OpenAI API key (required)
OPENAI_API_KEY=sk-your-key-here

# Default model for code generation
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo
# Can also use Claude models with appropriate baseUrl
MINI_IDE_MODEL=gpt-4o

# Custom API endpoint (optional)
# Use this to point to alternative OpenAI-compatible APIs
# Examples:
#   - Azure OpenAI: https://your-resource.openai.azure.com
#   - Local LLM: http://localhost:8080/v1
# OPENAI_BASE_URL=

# ESAA (Evolutionary Self-Aware Architecture)
# -------------------------------------------
# Enable ESAA mode for advanced multi-agent orchestration
ESAA_ENABLED=false

# Server Configuration
# --------------------
PORT=3200
LOG_LEVEL=info

# Session Storage
# ---------------
# Directory for session database storage
SESSION_STORAGE_PATH=./data/sessions
