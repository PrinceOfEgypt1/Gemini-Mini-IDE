{
  "name": "gemini-mini-ide-monorepo",
  "version": "1.0.0",
  "packageManager": "pnpm@9.12.2",
  "description": "Gemini Mini-IDE - Ambiente de Desenvolvimento Assistido por IA",
  "main": "index.js",
  "scripts": {
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "rebuild": "pnpm -r exec rm -rf dist && pnpm -r exec rm -f tsconfig.tsbuildinfo && pnpm -r build",
    "dev": "pnpm --filter @gemini-mini-ide/ui dev",
    "start": "pnpm --filter @gemini-mini-ide/server start",
    "clean": "pnpm -r exec rm -rf dist node_modules",
    "prepare": "pnpm -r build"
  },
  "keywords": [
    "ide",
    "ai",
    "typescript",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "@vitest/coverage-v8": "1.6.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^1.6.1"
  },
  "pnpm": {
    "overrides": {
      "@types/node": "^20.10.0",
      "typescript": "^5.3.3",
      "vitest": "^1.6.1"
    }
  }
}
